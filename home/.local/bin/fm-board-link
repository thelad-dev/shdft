#!/usr/bin/env bash
# Schreibt "URL|offene Karten|Stand" fuer die Statuszeile: das aelteste noch offene Lavish-Board.
# "Offen" heisst: die Lavish-Sitzung ist nicht beendet (Status open in der Sitzungsliste) und die Datei existiert.
# "Aelteste" zaehlt nach Anlage der Datei (Geburtszeit, sonst Aenderungszeit). Nur lesend; das Argument
# (Arbeitsverzeichnis der Sitzung) wird nicht mehr gebraucht und bleibt nur aus Kompatibilitaet erlaubt.
out="${XDG_CACHE_HOME:-$HOME/.cache}/claude-statusline/board.txt"
mkdir -p "$(dirname "$out")"
sessions=$(timeout 8 lavish-axi 2>/dev/null)

board=""; url=""; oldest=""
while IFS= read -r row; do
  file=${row%%,open,*}; file=${file#"${file%%[![:space:]]*}"}
  link=$(printf '%s' "$row" | grep -o 'http[^"]*' | head -1)
  [ -f "$file" ] && [ -n "$link" ] || continue
  t=$(stat -c %W "$file" 2>/dev/null); { [ -n "$t" ] && [ "$t" -gt 0 ] 2>/dev/null; } || t=$(stat -c %Y "$file")
  if [ -z "$oldest" ] || [ "$t" -lt "$oldest" ]; then oldest=$t; board=$file; url=$link; fi
done < <(printf '%s\n' "$sessions" | grep -F ',open,')
[ -n "$board" ] || { : > "$out"; exit 0; }

# Offene Karten nur fuer bearings-Boards (Nutzlast mit captains_call); sonst 0.
n=$(python3 - "$board" <<'PY'
import json,re,sys
s=open(sys.argv[1],encoding='utf-8').read()
dec=json.JSONDecoder()
for m in re.finditer(r'\{"schema"',s):
    try:
        o,_=dec.raw_decode(s[m.start():]); print(len(o.get('captains_call',[]))); break
    except Exception: pass
else: print(0)
PY
)
printf '%s|%s|%s\n' "$url" "${n:-0}" "$(date +%H:%M)" > "$out.tmp" && mv "$out.tmp" "$out"
